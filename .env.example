# Copy this file to .env and fill in your own values.
# .env is gitignored, so your real bucket name and profile never reach GitHub.

# S3 bucket that holds raw/ and processed/ data (created in docs/aws_setup.md)
S3_BUCKET=your-bucket-name

# Named AWS CLI profile (from ~/.aws/credentials) with least-privilege access to that bucket
AWS_PROFILE=minigrid-pipeline

# Region where the bucket lives
AWS_REGION=eu-west-1
